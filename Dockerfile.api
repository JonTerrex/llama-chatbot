# ==========================================
# STAGE 1: Builder (Compilación y dependencias)
# ==========================================
FROM python:3.11-slim AS builder

# Copiar el binario de uv directamente desde la imagen oficial
COPY --from=astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

# Copiamos solo el requirements primero para aprovechar la caché de Docker
COPY requirements.txt .

# Generamos el entorno virtual e instalamos dependencias a velocidad extrema
RUN uv venv /app/.venv
RUN uv pip install --python /app/.venv -r requirements.txt

# ==========================================
# STAGE 2: Runner (Imagen final de producción)
# ==========================================
FROM python:3.11-slim

WORKDIR /app

# Copiamos el entorno virtual compilado desde el Stage 1
COPY --from=builder /app/.venv /app/.venv

# Copiamos el código fuente de la aplicación
COPY src/ /app/src/
COPY prompts/ /app/prompts/

# Inyectamos el .venv en el PATH del sistema para no tener que activarlo
ENV PATH="/app/.venv/bin:$PATH"
# Definimos variable de entorno para desactivar el Mock en producción si se requiere
ENV USE_MOCK="false" 

# Exponemos el puerto de FastAPI
EXPOSE 8000

# Comando de arranque inyectando la IP 0.0.0.0 para habilitar tráfico externo al contenedor
CMD ["uvicorn", "src.api:app", "--host", "0.0.0.0", "--port", "8000"]