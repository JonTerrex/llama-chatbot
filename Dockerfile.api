# ==========================================
# STAGE 1: Builder
# ==========================================
FROM python:3.12-slim AS builder

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Forzamos a uv a usar el Python del sistema base para evitar symlinks rotos
ENV UV_PYTHON_PREFERENCE=only-system
ENV UV_LINK_MODE=copy
ENV UV_COMPILE_BYTECODE=1

WORKDIR /app

COPY pyproject.toml uv.lock ./

# Sincronizamos las dependencias en /app/.venv utilizando /usr/local/bin/python
RUN uv sync --frozen --no-dev --no-install-project

# ==========================================
# STAGE 2: Runner
# ==========================================
FROM python:3.12-slim
WORKDIR /app

# Copiamos el entorno virtual cuyo intérprete existe en esta misma imagen base
COPY --from=builder /app/.venv /app/.venv

COPY src/ /app/src/
COPY prompts/ /app/prompts/

ENV PATH="/app/.venv/bin:$PATH"
ENV USE_MOCK="false"

EXPOSE 8000

CMD ["uvicorn", "src.api:app", "--host", "0.0.0.0", "--port", "8000"]